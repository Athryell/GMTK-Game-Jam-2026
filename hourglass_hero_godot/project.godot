; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Hourglass Hero"
config/description="A platformer where the player IS an hourglass. Every jump flips the glass, swaps plane and launches you."
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Tuning="*res://scripts/autoload/tuning.gd"
Game="*res://scripts/autoload/game.gd"
Screen="*res://scripts/autoload/screen.gd"

[display]

; 960x540 is the DESIGN resolution: every coordinate in the levels is in these
; units, and it must not change.
window/size/viewport_width=960
window/size/viewport_height=540
; Launches fullscreen. F11 toggles back — see scripts/autoload/screen.gd.
window/size/mode=3
; The size it takes when you leave fullscreen. Twice the design resolution, so
; the vector art still has real pixels to be drawn into.
window/size/window_width_override=1920
window/size/window_height_override=1080
; Canvas items are rasterized at the screen's true pixel count rather than at
; 960x540 and then blown up. The game is all vector shapes, so this is what
; makes the hourglass look drawn instead of pixelated — and fullscreen on a
; retina display now gets that for free.
window/stretch/mode="canvas_items"
; Letterbox rather than reveal. `expand` would hand taller screens extra world
; to see, and the camera limits in main.gd are computed from the viewport size —
; so the aspect ratio would quietly change how much of a level you can read.
window/stretch/aspect="keep"

