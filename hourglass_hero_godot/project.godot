; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sandbound"
config/description="A platformer where the player IS an hourglass. Every jump flips the glass, swaps plane and launches you."
run/main_scene="uid://c7ptq2r8q47sd"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.jpeg"

[autoload]

Tuning="*res://scripts/autoload/tuning.gd"
Game="*res://scripts/autoload/game.gd"
Glass="*res://scripts/autoload/glass.gd"
Screen="*res://scripts/autoload/screen.gd"
Audio="*res://scripts/autoload/audio.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/scale_mode="fractional"

[editor_plugins]

enabled=PackedStringArray("res://addons/level_tools/plugin.cfg")

